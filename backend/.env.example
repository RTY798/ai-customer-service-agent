# ── LLM API 配置 ──────────────────────────────────
# DeepSeek: https://platform.deepseek.com/
# OpenAI:   https://platform.openai.com/
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 数据 Provider ──────────────────────────────────
# "demo" = 使用内置演示数据
# 或 "module.path:ClassName" 使用自定义数据源
# DATA_PROVIDER=demo

# ── 服务配置 ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
